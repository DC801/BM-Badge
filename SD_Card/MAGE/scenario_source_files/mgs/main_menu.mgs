include "header.mgs";

on_load_main_menu {
	current_chapter = 0;
	register_colors()

	// todo: write commentary

	// register_commentary()
	// if (!ch1-commentary-notice) {
	// 	serial_commentary = true;
	// 	show serial dialog {
	// 		" "
	// 		"<c><bold>Serial commentary</> <c>is available for chapter 1!</> (This is on by default.) To enable or disable this commentary, type <c>COMMENTARY ON</> or <c>COMMENTARY OFF</> at the main menu."
	// 	}
	// 	ch1-commentary-notice = true;
	// }

	/* DEBUG QUICK STUFFS */
	ch2_map_init_serial_debug_message()
	if (debug_mode) {
		debug_commands()
	}
}

debug_commands {
	show serial_dialog {
		" "
		"<y>DEBUG></> everywhere"
		"<y>></> <c>RTFM</>: early access to RTFM books"
		" "
		"<y>DEBUG></> main menu only"
		"<y>></> <c>DEBUG CH2</>: list CH2 debug commands"
		"<y>></> <c>HUB</>: debug hub map"
		"<y>></> <c>DEMO</>: demo/sandbox, skipping skip all intro dialog"
		"<y>></> <c>RNGTEST</>: test RNG!() single syntax 20 times"
		"<y>></> <c>RNGTEST2</>: test RNG!() range syntax 20 times"
		"<y>></> <c>BUFFER TEST</>: test serial messages sizes"
		"Go to the CH2 town for the <c>CUTBUG</> test"
	};
	command debug + "ch2" = {
		show serial_dialog {
			" "
			"<y>DEBUG CH2></> commands that work everywhere"
			"<y>></> <c>STORYFLAG _</>: set CH2 round"
			"<y>></> <c>WARP _</>: warp to CH2 destination"
			" "
			"<y>DEBUG CH2></> skips from main menu only"
			"<y>></> <c>ENTRANCE</>: room #1, after first half of Lambda convo"
			"<y>></> <c>CH2</>: birthday cutscene"
			"<y>></> <c>BOB</>: bob's club entrance"
			"<y>></> <c>BOB2</>: bob's club basement"
			"<y>></> <c>BOB3</>: bob's club basement (post cutscene)"
			"<y>></> <c>SIMON</>: Simon Says"
			"<y>></> <c>KING</>: cutscene where the king meets his advisors"
			"<y>></> <c>BOOT</>: boot the Gibson mainframe"
			"<y>></> <c>POST</>: post credits scene"
			"<y>></> <c>SKIP _</>: skip to storyflag round and set all prev flags"
		};
	};
	command entrance = {
		debug_set_flags_to_round0()
		ch2_load_castle_1_special()
	};
	command demo = {
		demo_cutseen_timewarp = true;
		load map demo;
	};
	command rngtest = {
		for (i = 0; i < 20; i += 1) {
			tempvar = RNG!(=4);
			show serial_dialog { "random number from 0 to 4: $tempvar$" };
		}
	};
	command rngtest2 = {
		for (i = 0; i < 20; i += 1) {
			tempvar = RNG!(40,=44);
			show serial_dialog { "random number from 40 to 44: $tempvar$" };
		}
	};
	command hub = {
		load map warp_zone;
	};
	command honk = {
		show serial_dialog { "Honk!" };
	};
	command bob = {
		ch2_has_artifact = true;
		ch2_has_map = true;
		load map "ch2-bobsclub";
	};
	command bob2 = {
		warp_state = warping;
		ch2_has_artifact = true;
		ch2_has_map = true;
		load map "ch2-bobsclub-basement";
	};
	command bob3 = {
		warp_state = warping;
		ch2_has_artifact = true;
		ch2_has_map = true;
		ch2_cutseen_bob_party = true;
		load map "ch2-bobsclub-basement";
	};
	command simon = {
		serial_control = true;
		ch2_has_artifact = true;
		hex_control = true;
		current_chapter = 2;
		debug_finish_toot()
		ch2_storyflag_round = 2;
		warp_ch2_31() // this has a load_map in it
	};
	command king = {
		debug_set_flags_to_round3()
		ch2_cutseen_castle13 = true;
		ch2_cutseen_castle14 = true;
		ch2_king_rescued = true;
		warp_state = "Ch2 King Returns";
		load map "ch2-castle-13";
	};
	command post = {
		ch2_wizard_backstory = true;
		debug_set_flags_to_round4()
		ch2_seen_room_99 = true;
		ch2_map_mainframeos = false;
		ch2_carrying_mainframeos = true;
		ch2_cutseen_castle99 = true;
		ch2_install_mainframeos()
		ch2_ring_zero_enabled_in_castle = true;
		ch2_storyflag_round = 5;
		credits_from_menu = false;
		warp_state = "ch2_ending";
		load map "ch2-castle-outside";
	};
	command ch2 = menu_chapter_select_2;
	command rtfm = command_rtfm;
	command buffer + test = debug_buffertest;
	command boot = ch2_bootup;
	command skip + "1" = debug_jump_to_round1;
	command skip + "2" = debug_jump_to_round2;
	command skip + "3" = debug_jump_to_round3;
	command skip + "4" = debug_jump_to_round4;
	register_warp()
	register_storyflag()

	// ARRAY ENCODING TESTS
	command array + gamut = array_json_test {
		json[
			{"action":"ARRAY_NEW","array_name":"arr"},
			{"action":"ARRAY_NEW","array_name":"asdf"},
			{"action":"ARRAY_DELETE","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_SORT","array_name":"arr"},
			{"action":"ARRAY_REVERSE","array_name":"arr"},
			{"action":"ARRAY_LENGTH_INTO_VARIABLE","array_name":"arr","variable":"varr"},
			{"action":"ARRAY_WRITE_INTO_INDEX_FROM_VALUE","value":0,"array_name":"arr","index":0},
			{"action":"ARRAY_WRITE_INTO_INDEX_FROM_VARIABLE","variable":"varr","array_name":"arr","index":0},
			{"action":"ARRAY_WRITE_INTO_VARIABLE_INDEX_FROM_VALUE","value":0,"array_name":"arr","variable_index":"vindex"},
			{"action":"ARRAY_WRITE_INTO_VARIABLE_INDEX_FROM_VARIABLE","variable":"varr","array_name":"arr","variable_index":"vindex"},
			{"action":"ARRAY_READ_FROM_INDEX_INTO_VARIABLE","variable":"varr","array_name":"arr","index":0},
			{"action":"ARRAY_READ_FROM_VARIABLE_INDEX_INTO_VARIABLE","variable":"varr","array_name":"arr","variable_index":"vindex"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":0,"array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VARIABLE","array_name":"arr","variable":"varr"},
			{"action":"ARRAY_PUSH_LEFT_FROM_VALUE","value":0,"array_name":"arr"},
			{"action":"ARRAY_PUSH_LEFT_FROM_VARIABLE","array_name":"arr","variable":"varr"},
			{"action":"ARRAY_SLICE","array_source":"source","array_destination":"dest","index_start":0},
			{"action":"ARRAY_SLICE_BY_VARIABLE","variable_start":"vstart","array_source":"source","array_destination":"dest"},
			{"action":"ARRAY_SLICE_TWICE","array_source":"source","array_destination":"dest","index_start":0,"index_end":0},
			{"action":"ARRAY_SLICE_TWICE_BY_VARIABLE","variable_start":"vstart","variable_end":"vend","array_source":"source","array_destination":"dest"},
			{"action":"ARRAY_POP_INTO_VARIABLE","variable":"varr","array_name":"arr"},
			{"action":"ARRAY_POP_LEFT_INTO_VARIABLE","variable":"varr","array_name":"arr"}
		]
	};

	command array + basics = array_basics {
		show serial_dialog { "---- Creating an array named 'arr'" };
		json[
			{"action":"ARRAY_NEW","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":0,"array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":99,"array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"}
		]
		show serial_dialog { "---- Creating another array named 'asdf'" };
		json[
			{"action":"ARRAY_NEW","array_name":"asdf"},
			{"action":"ARRAY_LOG","array_name":"asdf"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":1234,"array_name":"asdf"},
			{"action":"ARRAY_LOG","array_name":"asdf"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":72,"array_name":"asdf"},
			{"action":"ARRAY_LOG","array_name":"asdf"}
		]
		show serial_dialog { "---- Can both arrays be read afterward?" };
		json[
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"asdf"}
		]
		show serial_dialog { "---- Deleting array 'arr' and then trying to use it" };
		json[
			{"action":"ARRAY_DELETE","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":5,"array_name":"arr"}
		]
		show serial_dialog { "---- Deleting array 'arr' twice and then trying to use it" };
		json[
			{"action":"ARRAY_DELETE","array_name":"arr"},
			{"action":"ARRAY_DELETE","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VALUE","value":5,"array_name":"arr"}
		]
		show serial_dialog { "---- Assigning 3840 into a variable and then pushing that variable into an array" };
		array_read_test = 3840;
		array_write_test = 0;
		json[
			{"action":"ARRAY_NEW","array_name":"arr"},
			{"action":"ARRAY_PUSH_FROM_VARIABLE","variable":"array_read_test","array_name":"arr"},
			{"action":"ARRAY_LOG","array_name":"arr"},
			{"action":"ARRAY_READ_FROM_INDEX_INTO_VARIABLE","variable":"array_write_test","array_name":"arr","index":0}
		]
		show serial_dialog { "What is the value of array_write_test after read? $array_write_test$" };
	};
}

/* ---------- INTRO SPLASH ---------- */

// entity listens for a button press, and changes the map's on_tick to the menu itself
on_tick_button_to_skip {
	if (button ANY pressed) {
		map on_tick = main_menu_fade_in;
		goto null_script;
	}
}

// map script shows the splash, and can be interrupted by the handler above; otherwise it continues to the menu itself
on_tick_main_menu {
	hex_control = false;
	if (warp_state != "from_game") {
		camera = geometry "dc801-center";
		camera fade in -> #000000 over 800ms;
		wait 2900ms;
		camera fade out -> #000000 over 800ms;
		player on_tick = {};
	}
	goto main_menu_fade_in;
}

main_menu_fade_in {
	hex_control = false;
	player on_tick = {};
	camera = geometry "menu-center";
	camera fade in -> #000000 over 800ms;
	goto main_menu;
}

/* ---------- MAIN MENU ---------- */

main_menu {
	player on_tick = {};
	show dialog {
		name "" border_tileset menu
		"CHOOSE YOUR FATE"
		> "Play Game" = menu_play_game
		> "Play Demo" = load_map_demo_map
		> "Bling Mode" = menu_bling_mode
		> "Credits" = menu_credits_choice
	};
}

/* ---------- CREDITS ---------- */

menu_credits_choice {
	show dialog {
		name "" border_tileset menu
		"CREDITS"
		> "Chapter 1 credits" = {
			credits_from_menu = true;
			load map credits;
		}
		> "Chapter 2 credits" = {
			credits_from_menu = true;
			load map credits2;
		}
		> "Back" = main_menu
	};
}

/* ---------- BLING MODE ---------- */

menu_bling_mode {
	show dialog {
		name "" border_tileset menu
		"SAVE YOUR SCREEN"
		> "DC801 showcase" = menu_bling_dc801_showcase
		> "Flying \"Toasters\"" = start_bling_flying_toasters
		> "QR Codes" = start_bling_qr
		> "Back" = main_menu
	};
}

menu_bling_dc801_showcase {
	show dialog {
		name "" border_tileset menu
		"DC801 SHOWCASE"
		> "Auto mode" = start_bling_rotate_auto
		> "Manual mode" = start_bling_rotate_manual
		> "Back" = menu_bling_mode
	};
}

  //---------------------------------//
 /* ---------- PLAY GAME ---------- */
//---------------------------------//

fn load_slot ($n) {
	load slot $n;
	slot_number = $n;
	goto menu_chapter_select_q;
}
fn new_slot ($n) {
	erase slot $n;
	slot_number = $n;
	goto menu_player_name_q;
}
fn erase_slot ($n) {
	erase slot $n;
	goto menu_play_game;
}
menu_play_game {
	show dialog {
		name "" border_tileset menu
		"PLAY GAME"
		> "Load Game" = menu_load_game {
			show dialog {
				name "" border_tileset menu
				"LOAD GAME"
				> "Slot 0" = { load_slot(0) }
				> "Slot 1" = { load_slot(1) }
				> "Slot 2" = { load_slot(2) }
				> "Back" = menu_play_game
			};
		}
		> "New Game" = menu_new_game {
			show dialog {
				name "" border_tileset menu
				"NEW GAME"
				> "Slot 0" = { new_slot(0) }
				> "Slot 1" = { new_slot(1) }
				> "Slot 2" = { new_slot(2) }
				> "Back" = menu_play_game
			};
		}
		> "Erase Save" = menu_erase_save {
			show dialog {
				name "" border_tileset menu
				"BOOM TIME!"
				> "Erase slot 0" = { erase_slot(0) }
				> "Erase slot 1" = { erase_slot(1) }
				> "Erase slot 2" = { erase_slot(2) }
				> "Back" = menu_play_game
			};
		}
		> "Back" = main_menu
	};
}

// Set player name

fn name_preset ($name) {
	player name = $name;
	goto menu_player_name_confirm;
}

menu_player_name_confirm {
	show dialog {
		name "" border_tileset menu
		"Your name is %PLAYER%?"
		> "Yes" = start_new_game_with_name { // reused below
			save slot;
			goto menu_chapter_select_q;
		}
		> "No" = menu_player_name_reset { // reused below
			player name = "Bub";
			goto menu_player_name_q;
		}
	};
}
menu_player_name_q {
	show dialog {
		name "" border_tileset menu
		"NEW GAME: Pick your name."
		> "Red" = { name_preset("Red") }
		> "Bubbles" = { name_preset("Bubbles") }
		> "Black Mage" = { name_preset("Black Mage") }
		> "Gimme something random" = menu_player_name_random
	};
}


// Random

menu_player_name_random {
	rand!(
		player name = [
			"Chara",
			"Buster",
			"Tidus",
			"Frisk",
			"Farnsworth",
			"Cloud",
			"Ash",
			"Crono",
			"Terra",
			"Kremit",
			"Zidane",
			"Cecil",
			"Squall",
			"Roxas",
			"Steamed Hams",
			"Spy",
			"Tom Honks",
			"VeeVee",
			"XDDCC",
			"Bub"
		];
	)
	show dialog {
		name "" border_tileset menu
		"Your name is %PLAYER%?"
		> "Reroll random name" = menu_player_name_random
		> "Yes" = start_new_game_with_name
		> "No" = menu_player_name_reset
	};
}

/* ---------- CHOOSING A CHAPTER ---------- */

menu_chapter_select_q {
	tempvar2 = ch1_count_flags();
	tempvar3 = ch2_count_flags();
	show dialog {
		name "" border_tileset menu
		"PLAY (slot $slot_number$: \"%PLAYER%\")"
		> "Chapter 1 ($tempvar2$/11)" = menu_chapter_select_1
		> "Chapter 2 ($tempvar3$/10)" = menu_chapter_select_2_check
		> "Back" = menu_play_game
	};
}

menu_chapter_select_1 {
	current_chapter = 1;
	load map main;
}

menu_chapter_select_2_check {
	if (ch1_finished || warned_ch1_incomplete) {
		// passthrough
		goto menu_chapter_select_2;
	} else {
		warned_ch1_incomplete = true;
		show dialog {
			name "" border_tileset menu
			"Chapter 1 is unfinished!"
			> "Play chapter 2 anyway" = menu_chapter_select_2
			> "Never mind" = menu_chapter_select_q
		};
	}
}

menu_chapter_select_2 {
	current_chapter = 2;
	if (!ch2_cutseen_birthday) {
		load map "ch2-magehouse-birthday";
	}
	warp_state = "raw_game_load_ch2";
	if (playersave_room == 1) {
		ch2_load_castle_1_special()
	} else {
		load map "ch2-town";
	}
}

/* ---------- SAVE THE GAME ---------- */

menu_save_game {
	show dialog {
		name "Save Game"
		border_tileset codec
		portrait floppy
		"Would you like to save your progress?"
		> "Yes" = {
			capture_player_state()
			save slot;
			self on_interact = menu_save_game;
		}
		> "No" = {
			self on_interact = menu_save_game;
		}
		> "Return to Main Menu" = {
			warp_state = from_game;
			load map main_menu;
		}
	};
}
