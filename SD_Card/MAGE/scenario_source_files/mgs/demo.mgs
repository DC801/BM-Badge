check_if_player_is_goat_high_demo_map {
	if (player intersects geometry high) {
		entity goat1 on_tick = move_goat1_to_low_demo_map;
		entity goat2 on_tick = move_goat2_to_low_demo_map;
		goto check_if_player_is_goat_low_demo_map;
	}
}

check_if_player_is_goat_low_demo_map {
	if (player intersects geometry low) {
		entity goat1 on_tick = move_goat1_to_high_demo_map;
		entity goat2 on_tick = move_goat2_to_high_demo_map;
		goto check_if_player_is_goat_high_demo_map;
	}
}

move_goat1_to_low_demo_map {
	entity goat1 position -> geometry low1 origin over 600ms;
	entity goat1 position -> geometry low1 length over 2000ms forever;
}

move_goat2_to_low_demo_map {
	entity goat2 position -> geometry low2 origin over 733ms;
	entity goat2 position -> geometry low2 length over 2266ms forever;
}

move_goat1_to_high_demo_map {
	entity goat1 position -> geometry high1 origin over 600ms;
	entity goat1 position -> geometry high1 length over 2000ms forever;
}

move_goat2_to_high_demo_map {
	entity goat2 position -> geometry high2 origin over 733ms;
	entity goat2 position -> geometry high2 length over 2266ms forever;
}

loop_on_path_30s_demo_map {
	self position -> entity_path length over 20000ms forever;
}

loop_on_path_10s_demo_map {
	self position -> entity_path length over 6666ms forever;
}

loop_on_path_3s_demo_map {
	self position -> entity_path length over 2000ms forever;
}

// Chaos fish
show_dialog_demo_end_dream_q {
	show dialog {
		SELF
		portrait goldfish
		"End this dream?"
		> "Yes (save and quit)" = demo_end_dream_yes_save
		> "Yes (quit without saving)" = demo_end_dream_yes
		> "No (continue dream)" = demo_end_dream_no
	};
}
demo_end_dream_yes {
	load map main_menu;
}
demo_end_dream_yes_save {
	save slot;
	load map main_menu;
}
demo_end_dream_no {
	self on_interact = show_dialog_demo_end_dream_q;
}

// Unused (from original prerelease demo; did not get plugged in properly)
 dialog dialog_max3_demo_map {
	PLAYER "Not much of a market for fashion here, I would've thought."
	"Best of luck, Max Swagger!"
}

// --------------------------------------------------- FOLLOWING ENTITIES

$offset_x = 8;
$offset_y = 1;
$follow_delay = 2;
$queue_diff = 6;
$queue_size = 10;

follow_player_stack_init {
	offset_self_x = self x - $offset_x;
	offset_self_y = self y + $offset_y;
	// first in xy queue is follower's curr location
	queue_x0 = offset_self_x *1;
	queue_y0 = offset_self_y *1;
	// next four pos in queue are equal-sized steps between follower and followee
	if (player x > offset_self_x) {
		diff = player x - offset_self_x;
		step = diff / 5;
		queue_x1 = offset_self_x + step * 1;
		queue_x2 = offset_self_x + step * 2;
		queue_x3 = offset_self_x + step * 3;
		queue_x4 = offset_self_x + step * 4;
	} else {
		diff = offset_self_x - player x;
		step = diff / 5;
		queue_x1 = player x + step * 4;
		queue_x2 = player x + step * 3;
		queue_x3 = player x + step * 2;
		queue_x4 = player x + step * 1;
	}
	if (player y > offset_self_y) {
		diff = player y - offset_self_y;
		step = diff / 5;
		queue_y1 = offset_self_y + step * 1;
		queue_y2 = offset_self_y + step * 2;
		queue_y3 = offset_self_y + step * 3;
		queue_y4 = offset_self_y + step * 4;
	} else {
		diff = offset_self_y - player y;
		step = diff / 5;
		queue_y1 = player y + step * 4;
		queue_y2 = player y + step * 3;
		queue_y3 = player y + step * 2;
		queue_y4 = player y + step * 1;
	}
	// the rest of the queue is the followee's current pos
	// (the player will fill these in as they get to them)
	queue_x5 = player x;
	queue_x6 = player x;
	queue_x7 = player x;
	queue_x8 = player x;
	queue_x9 = player x;
	queue_y5 = player y;
	queue_y6 = player y;
	queue_y7 = player y;
	queue_y8 = player y;
	queue_y9 = player y;
	curr_self_queue = 0;
	curr_player_queue = $queue_diff;
}
record_player_pos_if ($n, $xVar, $yVar) {
	if (curr_player_queue == $n) {
		$xVar = player x;
		$yVar = player y;
	}
}
set_self_pos_if ($n, $xVar, $yVar) {
	if (curr_self_queue == $n) {
		self x = $xVar;
		self y = $yVar;
	}
}
follow_player {
	// wait 20ms;
	if (player current_animation != 1) {
		if (should_follow_player) {
			should_follow_player = false;
			should_follow_player_delay = $follow_delay;
		} else if (should_follow_player_delay != 0) {
			should_follow_player_delay -= 1;
		} else if (follow_player) {
			follow_player = false;
			self current_animation = 0;
		}
	} else {
		record_player_pos_if(0, queue_x0, queue_y0)
		record_player_pos_if(1, queue_x1, queue_y1)
		record_player_pos_if(2, queue_x2, queue_y2)
		record_player_pos_if(3, queue_x3, queue_y3)
		record_player_pos_if(4, queue_x4, queue_y4)
		record_player_pos_if(5, queue_x5, queue_y5)
		record_player_pos_if(6, queue_x6, queue_y6)
		record_player_pos_if(7, queue_x7, queue_y7)
		record_player_pos_if(8, queue_x8, queue_y8)
		record_player_pos_if(9, queue_x9, queue_y9)
		curr_player_queue = (curr_player_queue + 1) % $queue_size;
		if (!should_follow_player) {
			should_follow_player = true;
			follow_player_stack_init()
			should_follow_player_delay = $follow_delay;
		} else if (should_follow_player_delay != 0) {
			should_follow_player_delay -= 1;
		} else if (!follow_player) {
			follow_player = true;
			self current_animation = 1;
		}
	}

	if (follow_player) {
		// MOVE HAMSTER
		my_old_x = self x;
		my_old_y = self y;
		// advance the queue
		curr_self_queue = (curr_self_queue + 1) % $queue_size;
		// set position based on the queue value
		set_self_pos_if(0, queue_x0, queue_y0)
		set_self_pos_if(1, queue_x1, queue_y1)
		set_self_pos_if(2, queue_x2, queue_y2)
		set_self_pos_if(3, queue_x3, queue_y3)
		set_self_pos_if(4, queue_x4, queue_y4)
		set_self_pos_if(5, queue_x5, queue_y5)
		set_self_pos_if(6, queue_x6, queue_y6)
		set_self_pos_if(7, queue_x7, queue_y7)
		set_self_pos_if(8, queue_x8, queue_y8)
		set_self_pos_if(9, queue_x9, queue_y9)
		self x += $offset_x;
		self y -= $offset_y;
		// get the absolute value of the delta
		if (self x > my_old_x) {
			my_diff_x = self x - my_old_x;
		} else {
			my_diff_x = my_old_x - self x;
		}
		if (self y > my_old_y) {
			my_diff_y = self y - my_old_y;
		} else {
			my_diff_y = my_old_y - self y;
		}
		// turn the entity NSEW - check which axis changed more
		if (my_diff_x > my_diff_y) {
			if (self x > my_old_x) {
				self direction = east;
			} else if (self x < my_old_x) {
				self direction = west;
			}
		} else {
			if (self y > my_old_y) {
				self direction = south;
			} else if (self y < my_old_y) {
				self direction = north;
			}
			// if position is the same, don't turn at all (use current direction)
		}
	}
}
