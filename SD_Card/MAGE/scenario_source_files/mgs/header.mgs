add dialog settings {
	default { alignment BL }
	label PLAYER { entity "%PLAYER%" alignment BR }
	label SELF { entity "%SELF%" }

	label GBob { entity "Guardian Bob" }
	label ZIPPY { entity "Aunt Zippy" }
	label ZAPPY { entity "Uncle Zappy" }
}
/* todo: make this wrap to 64 instead, and adjust wrapped word colors */
add serial_dialog settings { wrap 60 }

fn set_hint_none_if_not_series ($n) {
	if (calculate_hinteger_series() == $n) {
		set_hint_none()
	}
}

fn get_entity_direction ($name, $captureVar) {
	if (entity $name direction == north) {
		$captureVar = 0;
	} else if (entity$name direction == east) {
		$captureVar = 1;
	} else if (entity $name direction == south) {
		$captureVar = 2;
	} else if (entity $name direction == west) {
		$captureVar = 3;
	}
}

fn restore_entity_direction ($name, $captureVar) {
if ($captureVar == 0) {
		entity $name direction = north;
	} else if ($captureVar == 1) {
		entity $name direction = east;
	} else if ($captureVar == 2) {
		entity $name direction = south;
	} else if ($captureVar == 3) {
		entity $name direction = west;
	}
}

fn get_diff_x ($e1, $e2) {
	if (entity $e1 x > entity $e2 x) {
		return entity $e1 x - entity $e2 x;
	} else {
		return entity $e2 x - entity $e1 x;
	}
}
fn get_diff_y ($e1, $e2) {
	if (entity $e1 y > entity $e2 y) {
		return entity $e1 y - entity $e2 y;
	} else {
		return entity $e2 y - entity $e1 y;
	}
}
fn get_manhattan_distance ($e1, $e2) {
	diff_x = get_diff_x($e1, $e2);
	diff_y = get_diff_y($e1, $e2);
	// TODO: I could have sworn you could have two FnCallReturn in one expression?
	return diff_x + diff_y;
}
