add dialog settings {
	default { alignment BL }
	label PLAYER { entity "%PLAYER%" alignment BR }
	label SELF { entity "%SELF%" }

	label GBob { entity "Guardian Bob" }
	label ZIPPY { entity "Aunt Zippy" }
	label ZAPPY { entity "Uncle Zappy" }
}

$MAX_INT = 65535;

/* todo: make this wrap to 64 instead, and adjust wrapped word colors */
add serial_dialog settings { wrap 60 }

fn set_hint_none_if_not_series ($n) {
	if (calculate_hinteger_series() == $n) {
		set_hint_none()
	}
}

fn capture_entity_direction ($name) {
	if (entity $name direction == north) { return 0; }
	else if (entity $name direction == east) { return 1; }
	else if (entity $name direction == south) { return 2; }
	else if (entity $name direction == west) { return 3; }
}

fn restore_entity_direction ($name, $captureVar) {
	if ($captureVar == 0) { entity $name direction = north; }
	else if ($captureVar == 1) { entity $name direction = east; }
	else if ($captureVar == 2) { entity $name direction = south; }
	else if ($captureVar == 3) { entity $name direction = west; }
}

fn get_diff ($a, $b) {
	if ($a > $b) {
		return $a - $b;
	} else {
		return $b - $a;
	}
}
fn get_manhattan_distance ($e1, $e2) {
	return get_diff(entity $e1 x, entity $e2 x) + get_diff(entity $e1 y, entity $e2 y);
}
