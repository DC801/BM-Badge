include "header.mgs";
add serial_dialog settings {
	wrap 70
}
$lightsdefault = ch2_serial_light_manager;

start_hanoi {
	player_control = off;
	hanoi_init_game()
	draw_hanoi()
	map on_tick = tick_hanoi;
}

$winning_plate = 6;

forecast_grip {
	if (grip_col == 1) {
		if (array1_length == 0) {
			return 0;
		} else if (array1_length == 1) {
			return array1_1;
		} else if (array1_length == 2) {
			return array1_2;
		} else if (array1_length == 3) {
			return array1_3;
		} else if (array1_length == 4) {
			return array1_4;
		} else if (array1_length == 5) {
			return array1_5;
		} else if (array1_length == 6) {
			return array1_6;
		} else if (array1_length == 7) {
			return array1_7;
		}
	} else if (grip_col == 2) {
		if (array2_length == 0) {
			return 0;
		} else if (array2_length == 1) {
			return array2_1;
		} else if (array2_length == 2) {
			return array2_2;
		} else if (array2_length == 3) {
			return array2_3;
		} else if (array2_length == 4) {
			return array2_4;
		} else if (array2_length == 5) {
			return array2_5;
		} else if (array2_length == 6) {
			return array2_6;
		} else if (array2_length == 7) {
			return array2_7;
		}
	} else if (grip_col == 3) {
		if (array3_length == 0) {
			return 0;
		} else if (array3_length == 1) {
			return array3_1;
		} else if (array3_length == 2) {
			return array3_2;
		} else if (array3_length == 3) {
			return array3_3;
		} else if (array3_length == 4) {
			return array3_4;
		} else if (array3_length == 5) {
			return array3_5;
		} else if (array3_length == 6) {
			return array3_6;
		} else if (array3_length == 7) {
			return array3_7;
		}
	}
}

array1_pop {
	if (array1_length == 7) {
		tempvar = array1_7 *1;
		array1_7 = 0;
	} else if (array1_length == 6) {
		tempvar = array1_6 *1;
		array1_6 = 0;
	} else if (array1_length == 5) {
		tempvar = array1_5 *1;
		array1_5 = 0;
	} else if (array1_length == 4) {
		tempvar = array1_4 *1;
		array1_4 = 0;
	} else if (array1_length == 3) {
		tempvar = array1_3 *1;
		array1_3 = 0;
	} else if (array1_length == 2) {
		tempvar = array1_2 *1;
		array1_2 = 0;
	} else if (array1_length == 1) {
		tempvar = array1_1 *1;
		array1_1 = 0;
	}
	array1_length -= 1;
	return tempvar;
}
fn array1_push ($value) {
	if ($value == 0) {
		show serial_dialog { "<r>ERROR!</> No value to push to Array #1!" };
		return;
	}
	if (array1_length >= 7) {
		show serial_dialog { "<r>ERROR!</> Array #1 is full! Cannot push!" };
		return;
	}
	if (array1_length == 6) {
		array1_7 = $value *1;
	} else if (array1_length == 5) {
		array1_6 = $value *1;
	} else if (array1_length == 4) {
		array1_5 = $value *1;
	} else if (array1_length == 3) {
		array1_4 = $value *1;
	} else if (array1_length == 2) {
		array1_3 = $value *1;
	} else if (array1_length == 1) {
		array1_2 = $value *1;
	} else if (array1_length == 0) {
		array1_1 = $value *1;
	}
	array1_length += 1;
}

array2_pop {
	if (array2_length == 7) {
		tempvar = array2_7 *1;
		array2_7 = 0;
	} else if (array2_length == 6) {
		tempvar = array2_6 *1;
		array2_6 = 0;
	} else if (array2_length == 5) {
		tempvar = array2_5 *1;
		array2_5 = 0;
	} else if (array2_length == 4) {
		tempvar = array2_4 *1;
		array2_4 = 0;
	} else if (array2_length == 3) {
		grip_vtempvaralue = array2_3 *1;
		array2_3 = 0;
	} else if (array2_length == 2) {
		tempvar = array2_2 *1;
		array2_2 = 0;
	} else if (array2_length == 1) {
		tempvar = array2_1 *1;
		array2_1 = 0;
	}
	array2_length -= 1;
	return tempvar;
}
fn array2_push ($value) {
	if ($value == 0) {
		show serial_dialog { "<r>ERROR!</> No value to push to Array #2!" };
		return;
	}
	if (array2_length >= 7) {
		show serial_dialog { "<r>ERROR!</> Array #2 is full! Cannot push!" };
		return;
	}
	if (array2_length == 6) {
		array2_7 = $value *1;
	} else if (array2_length == 5) {
		array2_6 = $value *1;
	} else if (array2_length == 4) {
		array2_5 = $value *1;
	} else if (array2_length == 3) {
		array2_4 = $value *1;
	} else if (array2_length == 2) {
		array2_3 = $value *1;
	} else if (array2_length == 1) {
		array2_2 = $value *1;
	} else if (array2_length == 0) {
		array2_1 = $value *1;
	}
	array2_length += 1;
}

array3_pop {
	if (array3_length == 7) {
		tempvar = array3_7 *1;
		array3_7 = 0;
	} else if (array3_length == 6) {
		tempvar = array3_6 *1;
		array3_6 = 0;
	} else if (array3_length == 5) {
		tempvar = array3_5 *1;
		array3_5 = 0;
	} else if (array3_length == 4) {
		tempvar = array3_4 *1;
		array3_4 = 0;
	} else if (array3_length == 3) {
		tempvar = array3_3 *1;
		array3_3 = 0;
	} else if (array3_length == 2) {
		tempvar = array3_2 *1;
		array3_2 = 0;
	} else if (array3_length == 1) {
		tempvar = array3_1 *1;
		array3_1 = 0;
	}
	array3_length -= 1;
	return tempvar;
}
fn array3_push ($value) {
	if ($value == 0) {
		show serial_dialog { "<r>ERROR!</> No value to push to Array #3!" };
		return;
	}
	if (array3_length >= 7) {
		show serial_dialog { "<r>ERROR!</> Array #3 is full! Cannot push!" };
		return;
	}
	if (array3_length == 6) {
		array3_7 = $value *1;
	} else if (array3_length == 5) {
		array3_6 = $value *1;
	} else if (array3_length == 4) {
		array3_5 = $value *1;
	} else if (array3_length == 3) {
		array3_4 = $value *1;
	} else if (array3_length == 2) {
		array3_3 = $value *1;
	} else if (array3_length == 1) {
		array3_2 = $value *1;
	} else if (array3_length == 0) {
		array3_1 = $value *1;
	}
	array3_length += 1;
}

hanoi_move {
	if (grip_value == 0) {
		if (grip_col == 1) {
			if (array1_length > 0) {
				array1_pop()
				hanoi_move_count += 1;
			}
		} else if (grip_col == 2) {
			if (array2_length > 0) {
				array2_pop()
				hanoi_move_count += 1;
			}
		} else if (grip_col == 3) {
			if (array3_length > 0) {
				array3_pop()
				hanoi_move_count += 1;
			}
		}
	} else {
		tempvar = forecast_grip();
		if (tempvar == 0 || tempvar > grip_value) {
			if (grip_col == 1) {
				array1_push(grip_value)
				grip_value = 0;
				hanoi_move_count += 1;
			} else if (grip_col == 2) {
				array2_push(grip_value)
				grip_value = 0;
				hanoi_move_count += 1;
			} else if (grip_col == 3) {
				array3_push(grip_value)
				grip_value = 0;
				hanoi_move_count += 1;
			}
		} else {
			plate_too_big = true;
		}
	}
	if (grip_value == $winning_plate) {
		hanoi_won = true;
	}
	draw_hanoi()
}
hanoi_move_1 {
	grip_col = 1;
	hanoi_move()
}
hanoi_move_2 {
	grip_col = 2;
	hanoi_move()
}
hanoi_move_3 {
	grip_col = 3;
	hanoi_move()
}

tick_hanoi {
	if (button HAX pressed) {
		player_control = on;
		hanoi_quit()
	} else if (
		button LJOY_UP pressed
		|| button RJOY_UP pressed
		|| button LJOY_DOWN pressed
		|| button RJOY_DOWN pressed
	) {
		hanoi_move()
	} else if (button LJOY_RIGHT pressed || button RJOY_RIGHT pressed) {
		if (grip_col == 1 || grip_col == 2) {
			grip_col += 1;
		}
		draw_hanoi()
	} else if (button LJOY_LEFT pressed || button RJOY_LEFT pressed) {
		if (grip_col == 2 || grip_col == 3) {
			grip_col -= 1;
		}
		draw_hanoi()
	}
}

/*
============================================================
     Cannot place larger plate on top of a smaller plate!    // row 10
         ||      YOU WON! Plate #6 grabbed!      ||          // row 11
         ||              Score: xx               ||          // row 10 (more digits = less spaces)
============================================================
=------------------ THE PLATES OF HANOI -------------------=
=----------------- Grab plate #6 to win! ------------------=
============================================================
         ||                  ||                  ||          // row 11
        /  \                 ||                  ||          // row 10
       [    ]               /  \                 ||          // row 9
                           [1111]                ||          // row 8
        1111                                     ||          // row 7
       222222              222222                ||          // row 6
      33333333            33333333               ||          // row 5
     4444444444          4444444444             /  \         // row 4
    555555555555        555555555555           [    ]        // row 3
   66666666666666      66666666666666                        // row 2
  7777777777777777    7777777777777777          1111         // row 1
============================================================
  Joysticks to control grabber arm, HAX button to quit ~OR~
  Tray (1-3) to grab/release plate, (T)ips, (R)eset, (Q)uit
============================================================
*/
hanoi_won_message_top {
	if (grip_col == 1) {
		concat serial_dialog hanoi_won_message1a;
	} else if (grip_col == 2) {
		concat serial_dialog hanoi_won_message2a;
	} else if (grip_col == 3) {
		concat serial_dialog hanoi_won_message3a;
	}
}
hanoi_won_message_bot {
	if (grip_col == 1) {
		concat serial_dialog hanoi_won_message1b;
	} else if (grip_col == 2) {
		concat serial_dialog hanoi_won_message2b;
	} else if (grip_col == 3) {
		if (hanoi_move_count < 100) {
			concat serial_dialog hanoi_won_message3b2; // 2-digit
		} else if (hanoi_move_count < 1000) {
			concat serial_dialog hanoi_won_message3b3; // 3-digit
		} else {
			concat serial_dialog hanoi_won_message3b4; // 4-digit (or more I guess)
		}
	}
}
serial_dialog hanoi_won_message1a  { "         ||      <g>YOU WON! Plate #6 grabbed!</>" }
serial_dialog hanoi_won_message2a  { "                 <g>YOU WON! Plate #6 grabbed!</>" }
serial_dialog hanoi_won_message3a  { "                 <g>YOU WON! Plate #6 grabbed!</>      ||" }
serial_dialog hanoi_won_message1b  { "         ||              <g>Score: $hanoi_move_count$</>" }
serial_dialog hanoi_won_message2b  { "                         <g>Score: $hanoi_move_count$</>" }
serial_dialog hanoi_won_message3b2 { "                         <g>Score: $hanoi_move_count$</>               ||" }
serial_dialog hanoi_won_message3b3 { "                         <g>Score: $hanoi_move_count$</>              ||" }
serial_dialog hanoi_won_message3b4 { "                         <g>Score: $hanoi_move_count$</>             ||" }
serial_dialog hanoi_space          { "                    " }
serial_dialog hanoi_grip_arm     { "         ||         " }
serial_dialog hanoi_grip_hinge   { "        /  \\        " }
fn draw_grip ($grip_value) {
		 if ($grip_value == 0) { concat serial_dialog { "       [    ]       " }; }
	else if ($grip_value == 1) { concat serial_dialog { "       [1111]       " }; }
	else if ($grip_value == 2) { concat serial_dialog { "      [222222]      " }; }
	else if ($grip_value == 3) { concat serial_dialog { "     [33333333]     " }; }
	else if ($grip_value == 4) { concat serial_dialog { "    [4444444444]    " }; }
	else if ($grip_value == 5) { concat serial_dialog { "   [555555555555]   " }; }
	else if ($grip_value == 6) { concat serial_dialog { "  [66666666666666]  " }; }
	else if ($grip_value == 7) { concat serial_dialog { " [7777777777777777] " }; }
}
fn draw_plate ($plate) {
		 // TODO: why does it count as multiple dialogs (x4!) if I define these in place? Naming them doesn't matter
		 if ($plate == 0) { concat serial_dialog hanoi_space; }
	else if ($plate == 1) { concat serial_dialog { "        1111        " }; }
	else if ($plate == 2) { concat serial_dialog { "       222222       " }; }
	else if ($plate == 3) { concat serial_dialog { "      33333333      " }; }
	else if ($plate == 4) { concat serial_dialog { "     4444444444     " }; }
	else if ($plate == 5) { concat serial_dialog { "    555555555555    " }; }
	else if ($plate == 6) { concat serial_dialog { "   66666666666666   " }; }
	else if ($plate == 7) { concat serial_dialog { "  7777777777777777  " }; }
}
fn draw_value_in_cell ($plate_value, $col, $row) {
	if ($plate_value != 0) {
		draw_plate($plate_value)
	} else if (grip_col == $col) {
		if (grip_hinge_row < $row) {
			concat serial_dialog hanoi_grip_arm;
		} else if (grip_hinge_row == $row) {
			concat serial_dialog hanoi_grip_hinge;
		} else if (grip_row == $row) {
			draw_grip(grip_value)
		} else {
			concat serial_dialog hanoi_space;
		}
	} else {
		concat serial_dialog hanoi_space;
	}
}
fn draw_plates_in_row($plate1, $plate2, $plate3, $row) {
	draw_value_in_cell($plate1, 1, $row)
	draw_value_in_cell($plate2, 2, $row)
	draw_value_in_cell($plate3, 3, $row)
	concat serial_dialog newline;
}
draw_hanoi {
	if (grip_col == 1) {
		grip_row = array1_length + 2;
	} else if (grip_col == 2) {
		grip_row = array2_length + 2;
	} else if (grip_col == 3) {
		grip_row = array3_length + 2;
	}
	grip_hinge_row = grip_row + 1;
	// HEADER
	show serial_dialog {
		" "
		" "
		"============================================================"
		"=------------------ <m>THE PLATES OF HANOI</> -------------------="
		"=----------------- Grab plate #6 to win! ------------------="
		"============================================================"
	};

	// ROW 11
	if (hanoi_won) {
		hanoi_won_message_top()
	} else {
		for (i = 1; i <= 3; i += 1) {
			if (grip_col == i) {
				concat serial_dialog hanoi_grip_arm;
			} else {
				concat serial_dialog hanoi_space;
			}
		}
	}
	concat serial_dialog newline;

	// ROW 10
	if (plate_too_big) {
		show serial_dialog { "     <m>Cannot place larger plate on top of a smaller plate!</>" };
		plate_too_big = false;
	} else if (hanoi_won) {
		hanoi_won_message_bot()
	} else {
		for (i = 1; i <= 3; i += 1) {
			draw_value_in_cell(0, i, 10)
		}
	}
	concat serial_dialog newline;

	// ROW 8-9 (can't have plates)
	draw_plates_in_row(0, 0, 0, 9)
	draw_plates_in_row(0, 0, 0, 8)

	// ROW 2-7
	draw_plates_in_row(array1_7, array2_7, array3_7, 7)
	draw_plates_in_row(array1_6, array2_6, array3_6, 6)
	draw_plates_in_row(array1_5, array2_5, array3_5, 5)
	draw_plates_in_row(array1_4, array2_4, array3_4, 4)
	draw_plates_in_row(array1_3, array2_3, array3_3, 3)
	draw_plates_in_row(array1_2, array2_2, array3_2, 2)

	// ROW 1 (can't have grip)
	draw_plate(array1_1)
	draw_plate(array2_1)
	draw_plate(array3_1)
	concat serial_dialog newline;

	// FOOTER
	show serial_dialog {
		"============================================================"
		"  <c>Joysticks</> to control grabber arm, <c>HAX button</> to quit ~OR~"
		"  Tray (<c>1</>-<c>3</>) to grab/release plate, (<c>T</>)ips, (<c>R</>)eset, (<c>Q</>)uit"
		"============================================================"
	};
	if (hanoi_won) {
		hanoi_quit()
	} else if (hanoi_draw_help) {
		show serial_dialog {
			"<m>TIP:</> You only need uncover (and grab) the #6 plate; you need not move it to another tray and build the tower of plates again."
			"<m>TIP:</> Only put odd numbered plates on top of even plates and vice versa. E.g. put plate <bold>1</> on top of plate <bold>4</>, not <bold>3</> or <bold>5</>."
		};
		hanoi_draw_help = false;
	}
}

hanoi_unregister {
	delete command "1" ;
	delete command "2" ;
	delete command "3" ;
	delete command "T" ;
	delete command "TIPS" ;
	delete command "R" ;
	delete command "RESET" ;
	delete command "Q" ;
	delete command "QUIT" ;
	if (debug_mode) {
		delete command "WIN" ;
	}
}

hanoi_quit {
	// run in the map's on_tick
	player_control = on;
	light LED_USB = off;
	entity Lights on_tick = $lightsdefault;
	hanoi_unregister()
	if (!hanoi_won) {
		show serial_dialog {
			" "
			"Quitting <m>Plates of Hanoi</> (your progress has been saved)"
		};
	} else if (!ch2_carrying_plate || !ch2_installed_plate) {
		won_hanoi_get_plate()
	}
	goto on_tick_ch2_castle_34;
}
hanoi_help {
	hanoi_draw_help = true;
	hanoi_move()
}

hanoi_reset {
	hanoi_init_done = false;
	hanoi_init_variables()
	draw_hanoi()
}

hanoi_init_variables {
	grip_col = 1;
	grip_value = 0;
	[ array1_7, array1_6, array1_5, array1_4, array1_3, array1_2, array1_1 ] = [ 0, 1, 2, 3, 4, 5, 6 ];
	[ array2_7, array2_6, array2_5, array2_4, array2_3, array2_2, array2_1 ] = [ 0, 0, 0, 0, 0, 0, 0 ];
	[ array3_7, array3_6, array3_5, array3_4, array3_3, array3_2, array3_1 ] = [ 0, 0, 0, 0, 0, 0, 0 ];
	array1_length = 6;
	array2_length = 0;
	array3_length = 0;
	hanoi_move_count = 0;
	hanoi_init_done = true;
	hanoi_won = false;
}
hanoi_init_game {
	if (!hanoi_init_done || hanoi_won) {
		hanoi_init_variables()
	}
	command "1"     = hanoi_move_1;
	command "2"     = hanoi_move_2;
	command "3"     = hanoi_move_3;
	command "T"     = hanoi_help;
	command "TIPS"  = hanoi_help;
	command "R"     = hanoi_reset;
	command "RESET" = hanoi_reset;
	command "Q"     = hanoi_quit_from_terminal;
	command "QUIT"  = hanoi_quit_from_terminal;
	if (debug_mode) {
		command "WIN" = hanoi_win;
	}
	// debug!(hanoi_init_game)
	light LED_USB = on;
	entity Lights on_tick = {};
}
hanoi_quit_from_terminal {
	map on_tick = hanoi_quit;
}
hanoi_win {
	hanoi_won = true;
	hanoi_unregister()
	goto draw_hanoi;
}