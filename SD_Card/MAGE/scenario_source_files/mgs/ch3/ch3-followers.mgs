follow_player_stack_init {
	offset_self_x = self x;
	if (curr_follower == $nano) { offset_self_x -= 8; }
	if (curr_follower == $emacs) { offset_self_x += 8; }
	offset_self_y = self y + 1;
	// first in xy queue is follower's curr location
	queue_x0 = offset_self_x *1;
	queue_y0 = offset_self_y *1;
	// next four pos in queue are equal-sized steps between follower and followee
	diff = get_diff(player x, offset_self_x);
	if (player x > offset_self_x) {
		queue_x1 = offset_self_x + (1 * diff / 5);
		queue_x2 = offset_self_x + (2 * diff / 5);
		queue_x3 = offset_self_x + (3 * diff / 5);
		queue_x4 = offset_self_x + (4 * diff / 5);
	} else {
		queue_x1 = player x + (4 * diff / 5);
		queue_x2 = player x + (3 * diff / 5);
		queue_x3 = player x + (2 * diff / 5);
		queue_x4 = player x + (1 * diff / 5);
	}
	diff = get_diff(player y, offset_self_y);
	if (player y > offset_self_y) {
		queue_y1 = offset_self_y + (1 * diff / 5);
		queue_y2 = offset_self_y + (2 * diff / 5);
		queue_y3 = offset_self_y + (3 * diff / 5);
		queue_y4 = offset_self_y + (4 * diff / 5);
	} else {
		queue_y1 = player y + (4 * diff / 5);
		queue_y2 = player y + (3 * diff / 5);
		queue_y3 = player y + (2 * diff / 5);
		queue_y4 = player y + (1 * diff / 5);
	}
	// the rest of the queue is the followee's current pos
	// (the player will fill these in as they get to them)
	queue_x5 = player x;
	queue_x6 = player x;
	queue_x7 = player x;
	queue_x8 = player x;
	queue_x9 = player x;
	queue_y5 = player y;
	queue_y6 = player y;
	queue_y7 = player y;
	queue_y8 = player y;
	queue_y9 = player y;
	curr_self_queue = 0;
	curr_player_queue = 6;
}

fn save_player_pos_if ($n, $xVar, $yVar) {
	if (curr_player_queue == $n) {
		$xVar = player x;
		$yVar = player y;
	}
}
// save_player_pos { // ARRAY VERSION
// 	followingPlayerX[curr_player_queue] = player x;
// 	followingPlayerY[curr_player_queue] = player y;
// }
save_player_pos {
	save_player_pos_if(0, queue_x0, queue_y0)
	save_player_pos_if(1, queue_x1, queue_y1)
	save_player_pos_if(2, queue_x2, queue_y2)
	save_player_pos_if(3, queue_x3, queue_y3)
	save_player_pos_if(4, queue_x4, queue_y4)
	save_player_pos_if(5, queue_x5, queue_y5)
	save_player_pos_if(6, queue_x6, queue_y6)
	save_player_pos_if(7, queue_x7, queue_y7)
	save_player_pos_if(8, queue_x8, queue_y8)
	save_player_pos_if(9, queue_x9, queue_y9)
}
fn load_self_pos_if ($n, $xVar, $yVar) {
	if (curr_self_queue == $n) {
		self x = $xVar;
		self y = $yVar;
	}
}
// load_self_pos { // ARRAY VERSION
// 	self x = followingPlayerX[curr_self_queue];
// 	self y = followingPlayerY[curr_self_queue];
//	if (curr_follower == $nano) { self x += 8; }
//	if (curr_follower == $emacs) { self x -= 8; }
//	self y -= 1;
// }
load_self_pos {
	load_self_pos_if(0, queue_x0, queue_y0)
	load_self_pos_if(1, queue_x1, queue_y1)
	load_self_pos_if(2, queue_x2, queue_y2)
	load_self_pos_if(3, queue_x3, queue_y3)
	load_self_pos_if(4, queue_x4, queue_y4)
	load_self_pos_if(5, queue_x5, queue_y5)
	load_self_pos_if(6, queue_x6, queue_y6)
	load_self_pos_if(7, queue_x7, queue_y7)
	load_self_pos_if(8, queue_x8, queue_y8)
	load_self_pos_if(9, queue_x9, queue_y9)
	if (curr_follower == $nano) { self x += 8; }
	if (curr_follower == $emacs) { self x -= 8; }
	self y -= 1;
}
follow_player {
	// wait 20ms;
	if (player current_animation != 1) {
		if (should_follow_player) {
			should_follow_player = false;
			follow_delay_tick = $follow_delay;
		} else if (follow_delay_tick != 0) {
			follow_delay_tick -= 1;
		} else if (am_following_player) {
			am_following_player = false;
			self current_animation = 0;
		}
	} else {
		save_player_pos()
		curr_player_queue = (curr_player_queue + 1) % $queue_size;
		if (!should_follow_player) {
			should_follow_player = true;
			follow_player_stack_init()
			follow_delay_tick = $follow_delay;
		} else if (follow_delay_tick != 0) {
			follow_delay_tick -= 1;
		} else if (!am_following_player) {
			am_following_player = true;
			self current_animation = 1;
		}
	}

	// MOVE FOLLOWER
	if (am_following_player) {
		my_old_x = self x;
		my_old_y = self y;
		// advance the queue
		curr_self_queue = (curr_self_queue + 1) % $queue_size;
		// set position based on the new queue value
		load_self_pos()
		// get the absolute value of the delta
		if (self x > my_old_x) {
			my_diff_x = self x - my_old_x;
		} else {
			my_diff_x = my_old_x - self x;
		}
		if (self y > my_old_y) {
			my_diff_y = self y - my_old_y;
		} else {
			my_diff_y = my_old_y - self y;
		}
		// turn the entity NSEW - check which axis changed more
		if (my_diff_x > my_diff_y) {
			if (self x > my_old_x) {
				self direction = east;
			} else if (self x < my_old_x) {
				self direction = west;
			}
		} else {
			if (self y > my_old_y) {
				self direction = south;
			} else if (self y < my_old_y) {
				self direction = north;
			}
			// if position is the same, don't turn at all (use current direction)
		}
	}
}


interact_demo_nano {
	if (curr_follower != $nano) {
		if (curr_follower == $vim) {
			show dialog vim_quit { Vim ":wq" };
			entity Vim on_tick = face_player;
			entity Vim current_animation = 0;
		} else if (curr_follower == $emacs) {
			show dialog emacs_quit { Emacs "You'll be back." };
			entity Emacs on_tick = face_player;
			entity Emacs current_animation = 0;
		}
		curr_follower = $nano;
		follow_player_stack_init()
		entity Nano on_tick = follow_player;
		show dialog { SELF "I'll help now!" };
		
	} else {
		face_player()
		show dialog { SELF "I like turtles." };
	}
}

interact_demo_vim {
	if (curr_follower != $vim) {
		if (curr_follower == $nano) {
			show dialog nano_quit { Nano "Writing out!" };
			entity Nano on_tick = face_player;
			entity Nano current_animation = 0;
		} else if (curr_follower == $emacs) {
			show dialog emacs_quit;
			entity Emacs on_tick = face_player;
			entity Emacs current_animation = 0;
		}
		curr_follower = $vim;
		follow_player_stack_init()
		entity Vim on_tick = follow_player;
		show dialog { SELF ":e follow" };
	} else {
		face_player()
		show dialog { SELF ":up" };
	}
}

interact_demo_emacs {
	if (curr_follower != $emacs) {
		if (curr_follower == $nano) {
			show dialog nano_quit;
			entity Nano on_tick = face_player;
			entity Nano current_animation = 0;
		} else if (curr_follower == $vim) {
			show dialog vim_quit;
			entity Vim on_tick = face_player;
			entity Vim current_animation = 0;
		}
		curr_follower = $emacs;
		follow_player_stack_init()
		entity Emacs on_tick = follow_player;
		show dialog { SELF "About time." };
	} else {
		face_player()
		show dialog { SELF "'Sup?" };
	}
}
