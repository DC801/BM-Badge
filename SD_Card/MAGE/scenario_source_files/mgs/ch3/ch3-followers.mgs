include "header.mgs";
include "ch3-followers-generic.mgs";

$none = 0;
$nano = 1;
$vim = 2;
$emacs = 3;

follower_demo_stuff { // from map on_load
	entity Nano on_tick = face_player;
	entity Vim on_tick = face_player;
	entity Emacs on_tick = face_player;
	if (curr_follower == $none) {
		curr_follower = $nano;
		// should remember what the prev follower was
	}
	if (curr_follower == $nano) {
		entity Nano on_tick = {
			start_simple_follow_player(Nano);
		};
	} else if (curr_follower == $vim) {
		entity Vim on_tick = {
			start_simple_follow_player(Vim);
		};
	} else if (curr_follower == $emacs) {
		entity Emacs on_tick = {
			start_simple_follow_player(Emacs);
		};
	}
	init_timmy_following();
}

// VERSION A: second follower follows the first follower
// Makes Timmy appear to zoop once in a while
// Requires convulted logic to determine who the middle follower is
fn start_timmy_following ($followee) {
	follow_entity( "%SELF%", $followee, 2, 5, "timmy");
}
init_timmy_following {
	entity Timmy on_tick = {
		if (curr_follower == $nano) {
			start_timmy_following(Nano);
		} else if (curr_follower == $vim) {
			start_timmy_following(Vim);
		} else if (curr_follower == $emacs) {
			start_timmy_following(Emacs);
		}
	};
}

interact_demo_nano {
	if (curr_follower != $nano) {
		if (curr_follower == $vim) {
			stop_simple_follow_player(Vim);
			show dialog vim_quit { Vim ":wq" };
		} else if (curr_follower == $emacs) {
			stop_simple_follow_player(Emacs);
			show dialog emacs_quit { Emacs "You'll be back." };
		}
		show dialog { SELF "I'll help now!" };
		curr_follower = $nano;
		entity Nano on_tick = { start_simple_follow_player(Nano); };
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF "I like turtles." };
	}
}

interact_demo_vim {
	if (curr_follower != $vim) {
		if (curr_follower == $nano) {
			stop_simple_follow_player(Nano);
			show dialog nano_quit { Nano "Writing out!" };
		} else if (curr_follower == $emacs) {
			stop_simple_follow_player(Emacs);
			show dialog emacs_quit;
		}
		show dialog { SELF ":e follow" };
		curr_follower = $vim;
		entity Vim on_tick = { start_simple_follow_player(Vim); };
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF ":up" };
	}
}

interact_demo_emacs {
	if (curr_follower != $emacs) {
		if (curr_follower == $nano) {
			stop_simple_follow_player(Nano);
			show dialog nano_quit;
		} else if (curr_follower == $vim) {
			stop_simple_follow_player(Vim);
			show dialog vim_quit;
		}
		show dialog { SELF "About time." };
		curr_follower = $emacs;
		entity Emacs on_tick = { start_simple_follow_player(Emacs); };
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF "'Sup?" };
	}
}

// VERSION B: GOOSE TRAIN EXPERIMENT
// All entities follow the player, but at different distances and delay
// Results in organic clumping behavior
// Entities don't need to know who the other followers are
// THIS ONE IS CLEARLY BETTER

goose_train {
	show dialog {
		Goose "HONK! (Starting the goose train...)"
	};

	[entity Nano, entity Vim, entity Emacs] on_tick = face_player;
	entity Nano on_interact = {
		show dialog { SELF "Goose times."};
	};
	entity Vim on_interact = {
		show dialog { name "" "(Vim stares at you, inscrutable as always.)"};
	};
	entity Emacs on_interact = {
		show dialog { SELF "Don't look at me. You chose to start the goose train."};
	};
	entity Nano current_animation = 0;
	entity Vim current_animation = 0;
	entity Emacs current_animation = 0;

	entity Goose on_tick = {
		follow_entity(
			"Goose",
			"%PLAYER%",
			2,
			5,
			"goose1"
		);
	};
	entity "Goose " on_tick = {
		follow_entity(
			"Goose ",
			"%PLAYER%",
			4,
			10,
			"goose2"
		);
	};
	entity "Goose  " on_tick = {
		follow_entity(
			"Goose  ",
			"%PLAYER%",
			6,
			15,
			"goose3"
		);
	};
	entity Goose on_interact = say_honk { show dialog { SELF "HONK!" }; };
	entity "Goose " on_interact = say_honk;
	entity "Goose  " on_interact = say_honk;
}
