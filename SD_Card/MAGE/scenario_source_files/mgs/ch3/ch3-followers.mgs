include "header.mgs";
include "ch3-followers-generic.mgs";

$none = 0;
$nano = 1;
$vim = 2;
$emacs = 3;

fn start_timmy_following ($followee) {
	follow_entity(
		"%SELF%",
		$followee,
		qx_ffollower,
		qy_ffollower,
		should_ffollower,
		am_ffollower,
		ffollower_countdown
	);
}
init_timmy_following {
	should_ffollower = false;
	am_ffollower = false;
	ffollower_countdown = 0;
	entity Timmy on_tick = {
		if (curr_follower == $nano) {
			start_timmy_following(Nano);
		} else if (curr_follower == $vim) {
			start_timmy_following(Vim);
		} else if (curr_follower == $emacs) {
			start_timmy_following(Emacs);
		}
	};
}

follower_demo_stuff { // from map on_load
	entity Nano on_tick = face_player;
	entity Vim on_tick = face_player;
	entity Emacs on_tick = face_player;
	if (curr_follower == 0) {
		curr_follower = $nano;
		// should remember what the prev follower was
	}
	if (curr_follower == $nano) {
		entity Nano on_tick = start_follow_player;
	} else if (curr_follower == $vim) {
		entity Vim on_tick = start_follow_player;
	} else if (curr_follower == $emacs) {
		entity Emacs on_tick = start_follow_player;
	}
	// follower following
	init_timmy_following();
}

start_follow_player {
	follow_entity(
		"%SELF%",
		"%PLAYER%",
		qx_fplayer,
		qy_fplayer,
		should_fplayer,
		am_fplayer,
		fplayer_countdown
	);
}

fn stop_follow_player ($e) {
	entity $e on_tick = face_player;
	entity $e current_animation = 0;
	should_fplayer = false;
	am_fplayer = false;
	fplayer_countdown = 0;
}

interact_demo_nano {
	if (curr_follower != $nano) {
		if (curr_follower == $vim) {
			stop_follow_player(Vim);
			show dialog vim_quit { Vim ":wq" };
		} else if (curr_follower == $emacs) {
			stop_follow_player(Emacs);
			show dialog emacs_quit { Emacs "You'll be back." };
		}
		show dialog { SELF "I'll help now!" };
		curr_follower = $nano;
		entity Nano on_tick = start_follow_player;
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF "I like turtles." };
	}
}

interact_demo_vim {
	if (curr_follower != $vim) {
		if (curr_follower == $nano) {
			stop_follow_player(Nano);
			show dialog nano_quit { Nano "Writing out!" };
		} else if (curr_follower == $emacs) {
			stop_follow_player(Emacs);
			show dialog emacs_quit;
		}
		show dialog { SELF ":e follow" };
		curr_follower = $vim;
		entity Vim on_tick = start_follow_player;
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF ":up" };
	}
}

interact_demo_emacs {
	if (curr_follower != $emacs) {
		if (curr_follower == $nano) {
			stop_follow_player(Nano);
			show dialog nano_quit;
		} else if (curr_follower == $vim) {
			stop_follow_player(Vim);
			show dialog vim_quit;
		}
		show dialog { SELF "About time." };
		curr_follower = $emacs;
		entity Emacs on_tick = start_follow_player;
		init_timmy_following();
	} else {
		face_player()
		show dialog { SELF "'Sup?" };
	}
}
