include "header.mgs";

/* ---------- ON_TICK ---------- */

on_tick_ch3_mouseroom {
	goto on_tick_ch3_mouseroom_walk;
}

capture_entity_position ($e, $x, $y, $dir) {
	$dir = capture_entity_direction($e);
	$x = entity $e x;
	$y = entity $e y;
	// log_x = $x *1;
	// log_y = $y *1;
	// log_dir = $dir;
	// debug!("Capturing $log_x$, $log_y$ ($log_dir$)")
}

restore_entity_position ($e, $x, $y, $dir) {
	restore_entity_direction($e, $dir);
	entity $e x = $x;
	entity $e y = $y;
	// log_x = $x *1;
	// log_y = $y *1;
	// log_dir = $dir;
	// debug!("Restoring $log_x$, $log_y$ ($log_dir$)")
}

$arrow = 0;
$eye = 3;

// On my main dev box, if this is between 50-80ms, everything behaves correctly.
// Below 50ms the teleportations seem to fall victim to 1+ race conditions, and the entities swap completely incorrectly
// Above 80ms there appears to be a blankgap during the teleportations.
// Actual solution is what?
$wait = 50ms;

on_tick_ch3_mouseroom_walk {
	if (button PAGE pressed) {
		player_control = off;
		show serial_dialog {"\nCursor mode!"};

		debug!("Make player look invisible")
		player type = NULL;

		debug!("Move NULL to player")
		entity NULL position = player position;

		wait $wait;

		debug!("Move player to cursor")
		player position = entity cursor position;

		debug!("Make NULL watch cursor")
		entity NULL on_tick = {
			entity NULL direction = entity cursor;
		};

		debug!("Make NULL look like mage")
		entity NULL type = mage;

		debug!("Make cursor follow player")
		entity cursor on_tick = {
			// cursor_x = player x;
			// cursor_y = player y;
			// entity cursor x = cursor_x;
			// entity cursor y = cursor_y;
			entity cursor position = player position;
			if (entity cursor intersects geometry NW) {
				entity cursor current_animation = $eye;
				if (button RJOY_RIGHT pressed) {
					show dialog { name "" "These sky blue tiles can brighten up a bathroom or kitchen for a vintage, 50s look." };
				}
			} else if (entity cursor intersects geometry SW) {
				entity cursor current_animation = $eye;
				if (button RJOY_RIGHT pressed) {
					show dialog { name "" alignment TL "Bare concrete may be suitable for the unfinished basement or laundry room if you want to save money." };
				}
			} else if (entity cursor intersects geometry NE) {
				entity cursor current_animation = $eye;
				if (button RJOY_RIGHT pressed) {
					show dialog { name "" "A rarer offering: crimson shag carpet for a lush, luxorious look." };
				}
			} else if (entity cursor intersects geometry SE) {
				entity cursor current_animation = $eye;
				if (button RJOY_RIGHT pressed) {
					show dialog { name "" alignment TL "Can't go wrong with faux oak vinyl flooring. It's like real hardwood but easier to maintain." };
				}
			} else {
				entity cursor current_animation = $arrow;
			}
		};
	
		player_control = on;
		self on_tick = on_tick_ch3_mouseroom_mouse;
	}
}
on_tick_ch3_mouseroom_mouse {
	if (button PAGE pressed) {
		player_control = off;
		show serial_dialog {"\nPlayer mode!"};

		// debug!("Make NULL do nothing anymore")
		entity NULL on_tick = {};

		// debug!("Make cursor do nothing anymore")
		entity cursor on_tick = {};

		debug!("Make NULL look invisible")
		entity NULL type = NULL;

		debug!("Make player jump to NULL position")
		player position = entity NULL position;

		wait $wait;

		debug!("Move NULL to cursor")
		entity NULL position = entity cursor position;

		debug!("Make player look like mage")
		player type = mage;

		if (entity NULL direction == north) {
			player direction = north;
		} else if (entity NULL direction == east) {
			player direction = east;
		} else if (entity NULL direction == south) {
			player direction = south;
		} else if (entity NULL direction == west) {
			player direction = west;
		}

		player_control = on;
		self on_tick = on_tick_ch3_mouseroom_walk;
	}
}


/* ---------- ON_LOAD ---------- */

on_load_ch3_mouseroom {
	player direction = south;
	camera = geometry camera;
	entity NULL position = entity cursor position;
	show serial_dialog spacer;
	show serial_dialog {
		"Welcome to the <y>CURSOR TEST</>!"
		" "
		"Hit the <c>PAGE</> button to switch between controlling the mage and controlling the mouse."
	};
}
