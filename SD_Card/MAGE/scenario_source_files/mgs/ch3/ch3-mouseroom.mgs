/* ---------- ON_TICK ---------- */

on_tick_ch3_mouseroom {
	goto on_tick_ch3_mouseroom_walk;
}

capture_entity_position ($e, $x, $y, $dir) {
	$dir = capture_entity_direction($e);
	$x = entity $e x;
	$y = entity $e y;
	log_x = $x *1;
	log_y = $y *1;
	// debug!("Capturing $log_x$, $log_y$")
}

restore_entity_position ($e, $x, $y, $dir) {
	restore_entity_direction($e, $dir);
	entity $e x = $x;
	entity $e y = $y;
	log_x = $x *1;
	log_y = $y *1;
	// debug!("Restoring $log_x$, $log_y$")
}

on_tick_ch3_mouseroom_walk {
	if (button PAGE pressed) {
		player_control = off;
		show serial_dialog {"\nCursor mode!"};
		player type = cursor;
		entity cursor type = mage;

		// show serial_dialog {"Player:"};
		capture_entity_position("%PLAYER%", player_x, player_y, player_dir);
		// show serial_dialog {"Cursor:"};
		capture_entity_position(cursor, cursor_x, cursor_y, cursor_dir);
		// show serial_dialog {"Player:"};
		restore_entity_position("%PLAYER%", cursor_x, cursor_y, player_dir);
		// show serial_dialog {"Cursor:"};
		restore_entity_position(cursor, player_x, player_y, player_dir);

		print_x = player x;
		print_y = player y;
		// show serial_dialog {"PLAYER POS: $print_x$, $print_y$"};
	
		player_control = on;
		self on_tick = on_tick_ch3_mouseroom_mouse;
	}
}
on_tick_ch3_mouseroom_mouse {
	if (button PAGE pressed) {
		player_control = off;
		show serial_dialog {"\nPlayer mode!"};
		player type = mage;
		entity cursor type = cursor;

		// show serial_dialog {"Player:"};
		capture_entity_position("%PLAYER%", player_x, player_y, player_dir);
		// show serial_dialog {"Cursor:"};
		capture_entity_position(cursor, cursor_x, cursor_y, cursor_dir);
		// show serial_dialog {"Player:"};
		restore_entity_position("%PLAYER%", cursor_x, cursor_y, cursor_dir);
		// show serial_dialog {"Cursor:"};
		restore_entity_position(cursor, player_x, player_y, cursor_dir);

		print_x = player x;
		print_y = player y;
		// show serial_dialog {"PLAYER POS: $print_x$, $print_y$"};

		player_control = on;
		self on_tick = on_tick_ch3_mouseroom_walk;
	}
}


/* ---------- ON_LOAD ---------- */

on_load_ch3_mouseroom {
	// room unique stuff
	camera = geometry camera;
	show serial_dialog spacer;
	show serial_dialog {
		"Welcome to the <y>CURSOR TEST</>!"
		" "
		"Hit the <c>PAGE</> button to switch between controlling the mage and controlling the mouse."
	};
}
