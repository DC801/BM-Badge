include "header.mgs";

/* ---------- ON_TICK ---------- */

on_tick_ch3_mouseroom {
	goto on_tick_ch3_mouseroom_walk;
}

capture_entity_position ($e, $x, $y, $dir) {
	$dir = capture_entity_direction($e);
	$x = entity $e x;
	$y = entity $e y;
}

restore_entity_position ($e, $x, $y, $dir) {
	restore_entity_direction($e, $dir);
	entity $e x = $x;
	entity $e y = $y;
}

$arrow = 0;
$eye = 3;

fn hover ($dialog_name) {
	entity cursor current_animation = $eye;
	if (button RJOY_RIGHT pressed) {
		show dialog $dialog_name;
	}
}

on_tick_ch3_mouseroom_walk {
	if (button PAGE pressed) {
		show serial_dialog {"\nCursor mode!"};
		cursor_mode = true;

		player = entity NULL;
		entity NULL on_tick = {
			entity cursor position = entity NULL position;
		};
		entity Bub on_tick = {
			entity Bub direction = entity cursor;
		};

		entity cursor on_tick = {
			entity cursor position = player position;
			if (entity cursor intersects geometry NW) {
				hover(hover_ch3_nw);
			} else if (entity cursor intersects geometry SW) {
				hover(hover_ch3_sw);
			} else if (entity cursor intersects geometry NE) {
				hover(hover_ch3_ne);
			} else if (entity cursor intersects geometry SE) {
				hover(hover_ch3_se);
			} else if (entity cursor intersects geometry crt) {
				hover(hover_ch3_lambda_crt);
			} else if (entity cursor intersects geometry books) {
				hover(hover_ch3_lambda_books);
			} else if (entity cursor intersects geometry ration) {
				hover(hover_ch3_lambda_ration);
			} else if (entity cursor intersects geometry poster) {
				hover(hover_ch3_lambda_poster);
			} else if (entity cursor intersects geometry drawers) {
				hover(hover_ch3_lambda_drawer);
			} else if (entity cursor intersects geometry computer) {
				hover(hover_ch3_lambda_computer);
			} else if (entity cursor intersects geometry boxes) {
				hover(hover_ch3_lambda_box);
			} else if (entity cursor intersects geometry laundry) {
				hover(hover_ch3_lambda_laundry);
			} else if (entity cursor intersects geometry bed) {
				hover(hover_ch3_lambda_bed);
			} else if (entity cursor intersects geometry xc) {
				hover(hover_ch3_lambda_xc);
			} else {
				entity cursor current_animation = $arrow;
			}
		};
		self on_tick = on_tick_ch3_mouseroom_mouse;
	}
}
on_tick_ch3_mouseroom_mouse {
	if (button PAGE pressed) {
		show serial_dialog {"\nPlayer mode!"};
		cursor_mode = false;

		entity Bub on_tick = {};
		entity NULL on_tick = {};
		entity cursor on_tick = {};

		player = entity Bub;

		self on_tick = on_tick_ch3_mouseroom_walk;
	}
}


/* ---------- ON_LOAD ---------- */

on_load_ch3_mouseroom {
	entity NULL floating = true;
	entity cursor floating = true;
	player direction = south;
	camera = geometry camera;
	hex_control = on;
	entity NULL position = entity cursor position;
	show serial_dialog spacer;
	show serial_dialog {
		"Welcome to the <y>CURSOR TEST</>!"
	};
	show serial_dialog cursor_test_explanation {
		" "
		"Hit the <c>PAGE</> button to switch between controlling the mage and controlling the mouse."
		" "
		"Type <c>ALT</> to see the alternate cursor test scenario (floor rennovation showcase vs Lambda's room)"
	};
	command alt = {
		if (!floor_showcase) {
			show serial_dialog spacer;
			show serial_dialog { "<y>WELCOME TO THE FLOOR RENNOVATION SHOWCASE!</>" };
			show serial_dialog cursor_test_explanation;
			camera = geometry camera2;
			entity Bub position = geometry player_floor_point;
			entity NULL position = geometry cursor_floor_point;
			entity cursor position = geometry cursor_floor_point;
			floor_showcase = true;
		} else {
			show serial_dialog spacer;
			show serial_dialog { "<y>Back at Lambda's room....</>" };
			show serial_dialog cursor_test_explanation;
			camera = geometry camera;
			entity Bub position = geometry player_room_point;
			entity NULL position = geometry cursor_room_point;
			entity cursor position = geometry cursor_room_point;
			floor_showcase = false;
		}
	};
}

// ----------------------------------------------------------


dialog hover_ch3_lambda_xc {
	name "" "(Wow, it looks just like the spider robot in the first room of the castle.)"
}

dialog hover_ch3_lambda_books {
	name "" "(Why do these books all have weird black-and-white pictures of animals on their covers when they're about programmming?)"
		"(Oh, this one has a cool dragon on the cover, but... no, I guess this one is about programming, too.)"
}

dialog hover_ch3_lambda_ration {
	name "" "(It's a meal, ready to eat.)"
}

dialog hover_ch3_lambda_poster {
	name "" "(Policenauts? Must be an anime.)"
}

dialog hover_ch3_lambda_drawer {
	name "" "(It's full of cables. But how many years of tangle is this?)"
}

dialog hover_ch3_lambda_computer {
	name "" "(That looks a lot like the mainframe in the castle entrance.)"
}

dialog hover_ch3_lambda_box {
	name "" alignment TL "(It's just a box....)"
}

dialog hover_ch3_lambda_laundry {
	name "" alignment TL "(That must be his laundry. I wonder where his washing machine is.)"
}

dialog hover_ch3_lambda_crt {
	name "" "(That's a weird screen. It flickers when I look at it from the corner of my eye.)"
}

dialog hover_ch3_lambda_bed {
	name "" "(I guess he has to sleep in a sleeping bag.)"
}

dialog hover_ch3_nw {
	name "" "These sky blue tiles can brighten up a bathroom or kitchen for a vintage, 50s look."
}
dialog hover_ch3_sw {
	name "" alignment TL "Bare concrete may be suitable for the unfinished basement or laundry room if you want to save money."
}
dialog hover_ch3_ne {
	name "" "A rarer offering: crimson shag carpet for a lush, luxorious look."
}
dialog hover_ch3_se {
	name "" alignment TL "Can't go wrong with faux oak vinyl flooring. It's like real hardwood but easier to maintain."
}
