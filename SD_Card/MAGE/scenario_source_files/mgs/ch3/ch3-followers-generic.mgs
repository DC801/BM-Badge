$follow_delay = 2;
$follow_distance = 5;

// make array that interpolates between x1 and x2 (or y1 and y2) 
fn init_queue ($queue_name, $start, $end, $step_count) {
	diff = get_diff($end, $start);
	array $queue_name = [ $start ];
	if ($start < $end) {
		for (i = 1; i < $step_count; i+=1) {
			$queue_name.push($start + (i * diff / $step_count));
		}
	} else {
		for (i = $step_count-1; i > 0; i-=1) {
			$queue_name.push($end + (i * diff / $step_count));
		}
	}
	// $queue_name.push($end);
}

fn offset_e_x_for_read_using_v ($e, $v) {
	v = $v +0;
	if (entity $e type == nano) {
		v += 8;
	} else if (
		entity $e type == eye_faerie
		|| entity $e type == emacs
	) {
		v -= 8;
	}
	return v;
}
fn offset_e_x_for_write_using_v ($e, $v) {
	v = $v +0;
	if (entity $e type == nano) {
		v -= 8;
	} else if (
		entity $e type == eye_faerie
		|| entity $e type == emacs
	) {
		v += 8;
	}
	return v;
}

fn offset_e_x_for_read ($e) {
	return offset_e_x_for_read_using_v($e, entity $e x);
}
fn offset_e_x_for_write ($e) {
	return offset_e_x_for_write_using_v($e, entity $e x);
}

fn load_entity_pos ($queue_x, $queue_y, $e) {
	v = $queue_x.pop_left();
	entity $e x = offset_e_x_for_read_using_v($e, v);
	entity $e y = $queue_y.pop_left();
	if (entity $e type != mage) {
		entity $e y -= 1;
	}
}
fn save_entity_pos ($queue_x, $queue_y, $e) {
	$queue_x.push(offset_e_x_for_write($e));
	$queue_y.push(entity $e y);
}
fn init_double_queue ($x, $y, $fwer, $fwee, $pad) {
	init_queue(
		$x,
		offset_e_x_for_write($fwer), 
		offset_e_x_for_write($fwee),
		$pad
	);
	init_queue(
		$y,
		entity $fwer y,
		entity $fwee y,
		$pad
	);
}

fn follow_entity ($fwer, $fwee, $qx, $qy, $should_follow, $am_following, $countdown) {
	if (entity $fwee current_animation != 1) {
		if ($should_follow) {
			$should_follow = false;
			$countdown = $follow_delay;
		} else if ($countdown != 0) {
			$countdown = $countdown - 1;
		} else if ($am_following) {
			$am_following = false;
			entity $fwer current_animation = 0;
		}
	} else {
		if (!$should_follow) {
			$should_follow = true;
			init_double_queue($qx, $qy, $fwer, $fwee, $follow_distance);
			$countdown = $follow_delay;
		} else if ($countdown != 0) {
			$countdown = $countdown - 1;
		} else if (!$am_following) {
			$am_following = true;
			entity $fwer current_animation = 1;
		}
		save_entity_pos($qx, $qy, $fwee);
	}

	// MOVE FOLLOWER
	if ($am_following) {
		my_old_x = entity $fwer x;
		my_old_y = entity $fwer y;
		// set follower position
		load_entity_pos($qx, $qy, $fwer);
		// get the absolute value of the delta
		my_diff_x = get_diff(entity $fwer x, my_old_x);
		my_diff_y = get_diff(entity $fwer y, my_old_y);
		// turn the entity NSEW - check which axis changed more
		if (my_diff_x > my_diff_y) {
			if (entity $fwer x > my_old_x) {
				entity $fwer direction = east;
			} else if (entity $fwer x < my_old_x) {
				entity $fwer direction = west;
			}
		} else {
			if (entity $fwer y > my_old_y) {
				entity $fwer direction = south;
			} else if (entity $fwer y < my_old_y) {
				entity $fwer direction = north;
			}
			// if position is the same, don't turn at all (use current direction)
		}
	}
}
