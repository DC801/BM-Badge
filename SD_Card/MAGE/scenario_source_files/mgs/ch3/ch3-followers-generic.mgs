// make array that interpolates between x1 and x2 (or y1 and y2)
fn init_queue ($queue_name, $start, $end, $step_count) {
	diff = get_diff($end, $start);
	array $queue_name = [ $start ];
	if ($start < $end) {
		for (i = 1; i < $step_count; i+=1) {
			$queue_name.push($start + (i * diff / $step_count));
		}
	} else {
		for (i = $step_count-1; i > 0; i-=1) {
			$queue_name.push($end + (i * diff / $step_count));
		}
	}
	// $queue_name.push($end);
}

// adjust value using the entity's offset but an arbitrary position value
fn offset_e_x_for_read_using_v ($e, $v) {
	v = $v +0;
	if (entity $e type == nano) {
		v += 8;
	} else if (
		entity $e type == eye_faerie
		|| entity $e type == emacs
		|| entity $e type == goose
		|| entity $e type == "goose-bow"
	) {
		v -= 8;
	}
	return v;
}
fn offset_e_x_for_write_using_v ($e, $v) {
	v = $v +0;
	if (entity $e type == nano) {
		v -= 8;
	} else if (
		entity $e type == eye_faerie
		|| entity $e type == emacs
		|| entity $e type == goose
		|| entity $e type == "goose-bow"
	) {
		v += 8;
	}
	return v;
}
fn offset_e_y_for_read_using_v ($e, $v) {
	v = $v +0;
	// make sure the mage is always drawn on top
	if (entity $e type != mage) { // TODO: check action for entity is_player?
		v -= 1;
	}
	return v;
}
fn offset_e_y_for_write_using_v ($e, $v) {
	v = $v +0;
	if (entity $e type != mage) {
		v += 1;
	}
	return v;
}

// adjust value using the entity's offset and the same entity's current position
fn offset_e_x_for_read ($e) {
	return offset_e_x_for_read_using_v($e, entity $e x);
}
fn offset_e_x_for_write ($e) {
	return offset_e_x_for_write_using_v($e, entity $e x);
}
fn offset_e_y_for_read ($e) {
	return offset_e_y_for_read_using_v($e, entity $e y);
}
fn offset_e_y_for_write ($e) {
	return offset_e_y_for_write_using_v($e, entity $e y);
}


// take queued position and apply to the given entity
fn load_entity_pos ($queue_x, $queue_y, $e) {
	v = $queue_x.pop_left();
	entity $e x = offset_e_x_for_read_using_v($e, v);
	v = $queue_y.pop_left();
	entity $e y = offset_e_y_for_read_using_v($e, v);
}
// take entity position and save in the queue
fn save_entity_pos ($queue_x, $queue_y, $e) {
	$queue_x.push(offset_e_x_for_write($e));
	$queue_y.push(offset_e_y_for_write($e));
}

// create an entity position queue (one for x, one for y) for a target follower and followee
fn init_double_queue ($x, $y, $fwer, $fwee, $step_count) {
	init_queue(
		$x,
		offset_e_x_for_write($fwer), 
		offset_e_x_for_write($fwee),
		$step_count
	);
	init_queue(
		$y,
		offset_e_y_for_write($fwer), 
		offset_e_y_for_write($fwee),
		$step_count
	);
}

// Variable names must be unique for each follower/followee pair
// Follower and followee names should be the entity "given name" (on Tiled)
// Because this isn't moving an entity along a path (it's setting the x/y manually)
// you need to change the animation to walk/idle manually
fn follow_entity ($fwer, $fwee, $delay, $distance, $label) {
	// followee is not currently walking
	if (entity $fwee current_animation != 1) {
		if (`{$label}_should_follow`) {
			`{$label}_should_follow` = false;
			`{$label}_countdown` = $delay;
		} else if (`{$label}_countdown` != 0) {
			`{$label}_countdown` = `{$label}_countdown` - 1;
		} else if (`{$label}_is_following`) {
			`{$label}_is_following` = false;
			entity $fwer current_animation = 0;
		}
	// followee is currently walking
	} else {
		if (!`{$label}_should_follow`) {
			`{$label}_should_follow` = true;
			init_double_queue(`{$label}_x`, `{$label}_y`, $fwer, $fwee, $distance);
			`{$label}_countdown` = $delay;
		} else if (`{$label}_countdown` != 0) {
			`{$label}_countdown` = `{$label}_countdown` - 1;
		} else if (!`{$label}_is_following`) {
			`{$label}_is_following` = true;
			entity $fwer current_animation = 1;
		}
		save_entity_pos(`{$label}_x`, `{$label}_y`, $fwee);
	}

	// move follower
	if (`{$label}_is_following`) {
		my_old_x = entity $fwer x;
		my_old_y = entity $fwer y;
		// set follower position
		load_entity_pos(`{$label}_x`, `{$label}_y`, $fwer);
		// get the absolute value of the delta
		my_diff_x = get_diff(entity $fwer x, my_old_x);
		my_diff_y = get_diff(entity $fwer y, my_old_y);
		// turn the entity NSEW manually (based on which axis changed more)
		if (my_diff_x > my_diff_y) {
			if (entity $fwer x > my_old_x) {
				entity $fwer direction = east;
			} else if (entity $fwer x < my_old_x) {
				entity $fwer direction = west;
			}
		} else {
			if (entity $fwer y > my_old_y) {
				entity $fwer direction = south;
			} else if (entity $fwer y < my_old_y) {
				entity $fwer direction = north;
			}
			// if position is the same, don't turn at all (use current direction)
		}
	} else {
		face_player();
	}
}

// Nano, Vim, and Emacs take turns following the player
// Thus they can share queue names and variable names
// This bit is put in this file in case the `{$label}_should_follow` etc. pattern changes

fn start_simple_follow_player ($e) {
	follow_entity( $e, "%PLAYER%", 2, 5, "fplayer");
}

fn stop_simple_follow_player ($e) {
	entity $e on_tick = face_player;
	entity $e current_animation = 0;
	fplayer_should_follow = false;
	fplayer_is_following = false;
	fplayer_countdown = 0;
}
